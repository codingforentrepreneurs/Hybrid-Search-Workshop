# Leave blank to preview the UI locally. Real search requires Tiger Cloud.
DATABASE_URL=

# auto uses OpenRouter when its key is nonblank, otherwise local FastEmbed.
EMBEDDING_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_DIMENSIONS=384

# Local development only. Set a unique secret and DEBUG=false when deploying.
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
